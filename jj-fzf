# Split interactively
KEY[split]="Alt-I"
RUN[split]="jjfzf_split_i {2}"
DOC[split]='Use `jj split` to interactively select content diff hunks to be split into a new commit with an empty description.'
jjfzf_split_i()
(
  set -Eeuo pipefail
  # Split without message editing, instead keep only the first (original) description
  touch "$JJFZF_TEMPD/skip1"
  export POPFILE_LIST= KEEPFILE_LIST="$JJFZF_TEMPD/skip1"
  export JJ_EDITOR="$JJFZF_ABSPATHLIB/popfile.sh" # Override ui.editor and implement --without-description
