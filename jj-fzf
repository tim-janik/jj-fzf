KEY[bookmark]="Alt-B"
DOC[bookmark]='Create, move, delete jj bookmarks and git tags.'
RUN[bookmark]="jjfzf_run +x +e '$JJFZF_ABSPATHLIB'/bookmarks.sh -m {2}"

# Diffedit interactively
KEY[diffedit]="Alt-E"
RUN[diffedit]="jjfzf_run +e jj --no-pager diffedit -r {2}"
DOC[diffedit]='Use `jj diffedit` to interactively select content diff hunks to be kept in the currently selected revision, the rest is discarded.'

# Split files --without-description
jjfzf_filesplit()
(
  set -Eeuo pipefail
  COMMIT="$1"
  # read files affected by $COMMIT
  mapfile -t MAPFILE < <(jj --no-pager diff --name-only -r "$COMMIT")
  [[ ${#MAPFILE[@]} -gt 1 ]] ||
    return
  # create n-1 new commits from n files
  while [[ ${#MAPFILE[@]} -gt 1 ]] ; do
    unset 'MAPFILE[-1]' # unset 'MAPFILE[${#MAPFILE[@]}-1]'
    export JJ_EDITOR='true' # Override ui.editor to implement --without-description
    jjfzf_run +n jj split -m= -r "$COMMIT" -- "${MAPFILE[@]}"
  done
  jjfzf_run
)
export -f jjfzf_filesplit
KEY[filesplit]="Alt-F"
RUN[filesplit]="jjfzf_filesplit {2}"
DOC[filesplit]='Use `jj split` in a loop to split each file modified by the currently selected revision into its own commit.'

