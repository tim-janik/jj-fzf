# Log history
KEY[log]="Ctrl-L"
BINDINGS+=( --bind 'ctrl-l:execute( jjfzf_selected_history {+2} )' )
DOC[log]='Use `jj log` to browse the history including patches, for the selected revisions, or the ancestry of a single revision.'
jjfzf_selected_history()
(
  set -Eeuo pipefail
  if test -n "${2-}" ; then
    ALL="$(jjfzf_ccrevs "$@")"
  else
    ALL="..${1-@}"
  fi
  jjfzf_full_history "$ALL"
)
export -f jjfzf_selected_history

# New
KEY[new]="Ctrl-N"	POST[new]="+first"
RUN[new]='jjfzf_run jj --no-pager new $(jjfzf_chronological_change_ids {+2})'
DOC[new]='Use `jj new` to create a new revision on top of the currently selected revision(s).'

# Oplog Commits
KEY[oplog]="Ctrl-O"
RUN[oplog]="jjfzf_run +x +e '$JJFZF_ABSPATHLIB'/oplog.sh"
DOC[oplog]='Use `jj operation log` to browse the recent operations log. Use hotkeys to view operation diffs and history. Undo operations or restore its working copy into a new commit.'

# Push & fetch from remotes
KEY[push]="Ctrl-P"	POST[new]="+first"
DOC[push]='Use `jj git fetch` and `jj git push --tracked --deleted` to update the local and remote repositories. Pushing needs confirmation after a dry-run. Tries to push all refs if no revisions are currently selected.'
RUN[push]="jjfzf_push {2} {+2}"
jjfzf_push()
(
  set -Eeuo pipefail
  REVS=( --tracked --deleted )
  if test ${#@} -gt 2 -o "$1" != "$2" ; then # fzf selection beyond pointer
    shift # eat pointer
    ALL="$(jjfzf_ccrevs "$@")" &&
      REVS=( -r "$ALL" )
  fi
  STATUS=0
  jjfzf_run +n jj git fetch $JJFZF_COLOR $JJFZF_KEEPCOMMITS \
    || STATUS=$?
  if test $STATUS == 0 ; then
    jjfzf_run +n jj git push $JJFZF_COLOR "${REVS[@]}" --dry-run > $JJFZF_TEMPD/push.log 2>&1 \
      || STATUS=$?
    cat $JJFZF_TEMPD/push.log
  fi
  if test $STATUS != 0 || grep -qEi 'nothing *changed|won.?t push|rejected *commit' $JJFZF_TEMPD/push.log ; then
    read -p "Press Enter..."
  else
    read -p 'Proceed with actual push and submit changes? (y/N) ' YN
    [[ "${YN:0:1}" =~ [yY] ]] || exit 0
    jjfzf_run +n jj git push "${REVS[@]}"
  fi
  jjfzf_load_and_status
)
export -f jjfzf_push

