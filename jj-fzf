  "${BIND[@]}" \
  --bind "ctrl-r:transform-query( $ABSPATHSCRIPT revset-filter {q} )+become( exec $ABSPATHSCRIPT )" \
  --preview " exec ${ABSPATHSCRIPT%/*}/lib/preview.sh preview_revision {} {q} " \
