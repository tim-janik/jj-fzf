set -Eeuo pipefail #-x
die() { echo "${BASH_SOURCE[0]##*/}: **ERROR**: ${*:-aborting}" >&2; exit 127 ; }
ABSPATHSCRIPT=$(readlink -f "${BASH_SOURCE[0]}")	# Resolve symlinks to find installdir

# == Setup & Options ==
source "${ABSPATHSCRIPT%/*}"/lib/setup.sh	# preflight.sh common.sh
jjfzf_tempd					# assigns $JJFZF_TEMPD
ENTER=
PRINTOUT=
WITH_PREVIEW=true
while test $# -ne 0 ; do
  case "$1" in \
    --version)		echo "${ABSPATHSCRIPT##*/} `$JJFZF_ABSPATHLIB/../version.sh`"; exit ;;
    --help-bindings)	PRINTOUT="$1" ;;
    -h|--help)		echo "Usage: ${ABSPATHSCRIPT##*/} [--man] [--version] [OPTIONS...]"; exit ;;
    -c|+c|-r|+r|-s)	ENTER="$1" ;;
    --man)		exec man $JJFZF_ABSPATHLIB/../doc/jj-fzf.1 ;;
    --no-preview)	WITH_PREVIEW=false ;;
    -x)			set -x ;;
    *)         		break ;;
  esac
  shift
done

# == Config ==
export JJFZF_REVSET_OVERRIDE="$JJFZF_TEMPD/log_revset"
# Always ensure root relative paths
JJROOT="$(jj --ignore-working-copy --no-pager root 2>/dev/null)" &&
  cd "$JJROOT" ||
    die "$PWD: not a JJ repository"
JJ="jj --no-pager --ignore-working-copy"
export JJFZFT="$JJ log --no-graph -T"
RELOAD="reload-sync(cat $JJFZF_TEMPD/jjfzf_list)"	# see jjfzf_load

# == jjfzf_full_commit ==
# Show commit(s) with diff and full info
jjfzf_full_commit()
(
  set -Eeuo pipefail
  test -z "${1-}" &&	# may be revset
    exit 0
  jjfzf_jjlog "$JJFZF_LOG_DETAILED_CONFIG" $JJFZF_COLOR --no-graph -r "$1" -p \
	      -T '"\n" ++ concat( builtin_log_oneline , builtin_log_detailed , diff.stat() , "\n" )'
)
export -f jjfzf_full_commit
jjfzf_log_detailed	# for preview, assigns $JJFZF_LOG_DETAILED_CONFIG

# == jjfzf_full_history ==
jjfzf_full_history()
(
  set -Eeuo pipefail
  REVSET="${1-@}"
  jjfzf_full_commit "$REVSET" |
    sed '1{/^$/d}' |
    $JJFZF_PAGER
)
export -f jjfzf_full_history

