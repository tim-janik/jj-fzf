# Interactive Revset
BINDINGS+=( --bind 'change:reload: jjfzf_revset_log {q} ' )
jjfzf_revset_log()
(
  Q="${1-}"
  if test "${Q:0:1}" != " " &&
      jj --no-pager --ignore-working-copy log --no-graph -T '' -r "@&($Q)" >/dev/null 2>&1 ; then
    echo "$Q" > $JJFZF_REVSET_OVERRIDE
  else
    rm -f $JJFZF_REVSET_OVERRIDE
  fi
  jjfzf_load --stdout
)
export -f jjfzf_revset_log

# Ctrl-F toggle FZF vs Revset
export JJFZF_PROMPT1="Revset > " JJFZF_ILABEL1="$(echo ' Ctrl-F: fzf-filter ⫶ Alt-Enter: save-revset ' | jjfzf_bold_keys)"
export JJFZF_PROMPT2="fzf > "    JJFZF_ILABEL2="$(echo ' Ctrl-F: Revset ' | jjfzf_bold_keys)"
BINDINGS+=( --disabled --prompt "$JJFZF_PROMPT1" )
BINDINGS+=( --bind 'ctrl-f:transform: jjfzf_fzf_transform' )
jjfzf_fzf_transform()
(
  # https://github.com/junegunn/fzf/blob/master/ADVANCED.md#switching-between-ripgrep-mode-and-fzf-mode-using-a-single-key-binding
  if [[ ! $FZF_PROMPT =~ Revset ]] ; then
    T="rebind(change)+rebind(alt-enter)+change-prompt($JJFZF_PROMPT1)+disable-search"
    T="$T+change-input-label($JJFZF_ILABEL1)"
    T="$T+change-ghost()"
    T="$T+transform-query:echo {q} > $JJFZF_TEMPD/q_fzf ; cat $JJFZF_TEMPD/q_revset"
  else
    T="unbind(change)+unbind(alt-enter)+change-prompt($JJFZF_PROMPT2)+enable-search"
    T="$T+change-input-label($JJFZF_ILABEL2)"
    T="$T+transform-query:echo {q} > $JJFZF_TEMPD/q_revset ; cat $JJFZF_TEMPD/q_fzf"
  fi
  echo "$T" # fzf transform instructions
)
export -f jjfzf_fzf_transform
BINDINGS+=( --bind 'ctrl-f,focus:+transform-ghost: [[ ! $FZF_PROMPT =~ Revset ]] && R={2} && echo -n "${R:0:12}" ' )

# Persist Revset
BINDINGS+=( --input-label="$JJFZF_ILABEL1" )
BINDINGS+=( --bind 'alt-enter:execute-silent( jjfzf_set_revset {q} )+reload( jjfzf_load --stdout )+clear-query' )
BINDINGS+=( --info-command='echo -e " \x1b[33;1m$FZF_POS\x1b[m/$FZF_INFO ⫶ all: $(jjfzf_revset)"' )
#KEY[revset]="Alt-Enter" # TODO: for --help only
#DOC[revset]='Persist current revset in repo configuration.'
jjfzf_set_revset()
(
  if test -z "${1-}" ; then			# reset
    if test "$(jj --no-pager --ignore-working-copy config get jj-fzf.log_revset 2>/dev/null)" == "" ; then
      RECENT7=' @:: | ancestors(immutable_heads()..,7) | tags() | bookmarks() | remote_bookmarks() | present(trunk()) '
      # toggle default revset
      jj --no-pager --ignore-working-copy config set --repo jj-fzf.log_revset "$RECENT7"
    else
      jj --no-pager --ignore-working-copy config unset --repo jj-fzf.log_revset
    fi
  elif test -r $JJFZF_REVSET_OVERRIDE ; then	# assign new if validated
    jj --no-pager --ignore-working-copy config set --repo jj-fzf.log_revset "$(cat $JJFZF_REVSET_OVERRIDE)"
  fi
  true
)
export -f jjfzf_set_revset

# == RUN commands ==
if [ -v "RUN[${1-}]" ]; then
  KEY="$1" && CMD="${RUN[$KEY]}" ; shift
  if [[ "$CMD" =~ \{ ]] ; then
    CIDS=( $(jjfzf_list_change_ids "${@-@}") )
    test "${#CIDS[@]}" -lt 1 &&
      die "missing revisions for command: $KEY"
    # Placeholder replacments
    while [[ "$CMD" =~ (.*)\{2\}(.*) ]] ; do
      CMD="${BASH_REMATCH[1]}${CIDS[0]}${BASH_REMATCH[2]}"
    done
    while [[ "$CMD" =~ (.*)\{[+]2\}(.*) ]] ; do
      CMD="${BASH_REMATCH[1]}${CIDS[*]}${BASH_REMATCH[2]}"
    done
    [[ "$CMD" =~ \{ ]] &&
      die "failed to run command: $KEY"
  fi
  export JJFZF_LOAD_LIST=true
  bash -c " $CMD "
  exit
fi

# == Process Bindings ==
declare -a CMDS # Sort commands by key binding string (KEY[$cmd])
while IFS= read -r line; do
  CMDS+=("${line#* }")
done < <(for cmd in "${!KEY[@]}"; do echo "${KEY[$cmd]} $cmd"; done | sort)
for cmd in "${CMDS[@]}"; do
  key="${KEY[$cmd],,}"
  post="$RELOAD${POST[$cmd]-}"
  KEYDOCS+=( "${KEY[$cmd]}: $cmd" )
  test -n "${RUN[$cmd]-}" &&
    BINDINGS+=( --bind "$key:execute( ${RUN[$cmd]} )+$post" )
done

# == jjfzf_showkeys ==
declare -p KEYDOCS > $JJFZF_TEMPD/jjfzf_KEYDOCS
jjfzf_showkeys()
(
  set +u
  HEADER_LINES="${LINES-$FZF_LINES}"
  test -n "$FZF_PREVIEW_LEFT" && test "$FZF_PREVIEW_LEFT" -gt $((FZF_COLUMNS / 10)) &&
    HEADER_COLUMNS="$FZF_PREVIEW_LEFT" || HEADER_COLUMNS="$FZF_COLUMNS"
  if test "$(jjfzf_config get jj-fzf.show-keys)" == false -o "$HEADER_LINES" -lt 20 -o "$HEADER_COLUMNS" -lt 20 ; then
    : # echo "Ctrl-H:help Alt-H:showkeys"
  else
    source $JJFZF_TEMPD/jjfzf_KEYDOCS
    FMT_WIDTH="$((HEADER_COLUMNS - 8))"	# Subtract fzf border
    printf '%s\n' "${KEYDOCS[@]}" |
      awk -v WIDTH="$FMT_WIDTH" -f $JJFZF_ABSPATHLIB/ocolumns.awk |
      jjfzf_bold_keys
  fi
)
export -f jjfzf_showkeys
BINDINGS+=( --bind "start,resize,alt-h,f11:+transform-header: jjfzf_showkeys 2>&1 " )

# == PRINTOUT ==
[[ "$PRINTOUT" == --help-bindings ]] && {
  for cmd in "${CMDS[@]}"; do
    echo
    echo "### _${KEY[$cmd]}_:" "**$cmd**"
    echo "${DOC[$cmd]}"
  done
  exit 0
}

# == fzf ==
V=$($JJFZF_ABSPATHLIB/../version.sh | sed 's/-0-g.*//; s/-[1-9][0-9]*-g.*/+/')
FZF_ARGS+=(
  --marker=' '
  --border-label "-[ JJ-FZF ($V) ]-" --color=border:cyan,label:cyan
  --preview-label " Revision Info "
)
$WITH_PREVIEW &&
  FZF_ARGS+=( --preview "jjfzf_full_commit {2} | sed '1{/^$/d}; 3001q' " )
jjfzf_status
export JJFZF_LOAD_LIST=jjfzf_log0
unset FZF_DEFAULT_OPTS FZF_DEFAULT_COMMAND
jjfzf_load --stdout |
  fzf -m "${FZF_ARGS[@]}" "${BINDINGS[@]}" \
      --read0 '-d¸' --accept-nth=2 --with-nth '{1} {4..}' \
      --header-first
# Notes:
# - Initial listing is read async to quickly popup the fzf log view
# - Commands are executed, then the new log is cached in $JJFZF_TEMPD/jjfzf_list and synchronously read by fzf
#   This allows fzf to track the current cursor position
