KEY[new-a]="Alt-N"
RUN[new-a]="jjfzf_run jj --no-pager new --no-edit --insert-after {2}"
DOC[new-a]='Use `jj new --no-edit --insert-after` to create and insert a new revision after the currently selected revision. Add `Ctrl` to use `--insert-before` instead.'
BINDINGS+=( --bind "ctrl-alt-n:execute( jjfzf_run jj --no-pager new --no-edit -B {2} )+$RELOAD+down" )

# Absorb a content diff into mutable ancestors
KEY[absorb]="Alt-O"
RUN[absorb]="jjfzf_run jj --no-pager absorb --from {2}"
DOC[absorb]='Use `jj absorb` to split the content diff of the current revision and squash pieces into related mutable ancestors.'

# Reparent Commits
KEY[reparent]="Alt-P"
DOC[reparent]='Change parent(s) of the current revision by adding a new or removing an existing parent, and optionally simplify the parent list.'
RUN[reparent]="jjfzf_run +x +e '$JJFZF_ABSPATHLIB'/reparent.sh {+2}"

# Squash
KEY[squash]="Alt-Q"
RUN[squash]="jjfzf_squash {2} {+2}"
DOC[squash]='Use `jj squash` to move the changes from all selected revisions into the revision under the cursor.'
jjfzf_squash()
(
  set -Eeuo pipefail
  TARGET="${1-}"; shift
  ALL="$(jjfzf_ccrevs "$@")"
  if test -n "$TARGET" ; then
    test "$TARGET" == "$ALL" && TARGET="$TARGET-"
    if test -n "$($JJFZFT 'true' -r "~$TARGET & ($ALL)")"; then
      if [[ true == $($JJFZFT 'true' -r "@ & ($ALL)") ]]; then
	# The working copy @ is to be squashed. Squashing without --keep-emptied would start a new branch at @- which
	# is undesired if @+ exists. But using --keep-emptied does not squash the message. As a workaround, create a
	# new @+, so we never squash directly from @. This new working copy will receive any children from the
	# original squashed working copy.
	jjfzf_run +n jj --no-pager new --insert-after @
      fi
      jjfzf_run jj --no-pager squash --from "$ALL" --into "$TARGET"
      return # already called jjfzf_load_and_status
    fi
  fi
  # else
  jjfzf_load_and_status
)
export -f jjfzf_squash

# Restore
KEY[restore]="Alt-S"
RUN[restore]="jjfzf_restore {2} {+2}"
DOC[restore]='Use `jj restore` to interactively select changes to be restored from a selected revisions into the revision under the cursor. Add `Ctrl` to run with `--restore-descendants`.'
BINDINGS+=( --bind "ctrl-alt-s:execute( jjfzf_restore --restore-descendants {2} {+2} )+$RELOAD" )
jjfzf_restore()
(
  set -Eeuo pipefail
  ARGS=()
  while [[ "${1-}" == --* ]] ; do
    ARGS+=("$1") && shift
  done
  TARGET="${1-}"; shift
  ALL="$(jjfzf_ccrevs "$@")"
  if test -n "$TARGET" ; then
    test "$TARGET" == "$ALL" && TARGET="$TARGET-"
    if test -n "$($JJFZFT 'true' -r "~$TARGET & ($ALL)")"; then
      jjfzf_run jj restore --interactive --from "$ALL" --into "$TARGET" "${ARGS[@]}"
      return # already called jjfzf_load_and_status
    fi
  fi
  # else
  jjfzf_load_and_status
)
export -f jjfzf_restore

# Rebase Commits
KEY[rebase]="Alt-R"
DOC[rebase]='Use `jj rebase` or `jj duplicate` to move or copy a set of revisions (possibly with descendants), onto, before or after another revision. Also supports `jj simplify-parents` afterwards.'
RUN[rebase]="jjfzf_run +x +e '$JJFZF_ABSPATHLIB'/rebase.sh {+2}"

# Revert Commits
KEY[revert]="Alt-V"	POST[revert]="+first"
RUN[revert]="jjfzf_run jj --no-pager revert -d @ -r \$(jjfzf_ccrevs {+2})"
DOC[revert]='Use `jj revert` to create new commits that undo the changes made by the currently selected revisions and apply the changes on top of the working-copy.'

# Swap
KEY[swap]="Alt-X"	POST[swap]="+down"
RUN[swap]="jjfzf_run jj --no-pager rebase --insert-before {2}- -r {2}"
DOC[swap]='Use `jj rebase --insert-before` to quickly swap the currenly selected revision with the revision immediately before it. Add `Ctrl` to use `--insert-after` instead.'
BINDINGS+=( --bind "ctrl-alt-x:execute( jjfzf_run jj --no-pager rebase --insert-after {2}+ -r {2} )+$RELOAD+up" )

# Redo
KEY[redo]="Alt-Y"
RUN[redo]="jjfzf_run jj --no-pager redo"
DOC[redo]='Use `jj redo` to redo the last undo operation performed by `jj undo`.'

# Undo
KEY[undo]="Alt-Z"
RUN[undo]="jjfzf_run jj --no-pager undo"
DOC[undo]='Use `jj undo` to undo the last operation performed by `jj` that was not previously undone.'

# Describe
KEY[describe]="Ctrl-D"
RUN[describe]="jjfzf_describe_commit {2}"
DOC[describe]='Use `jj describe` to describe the currently selected revision.'
jjfzf_describe_commit()
(
  REV="${1-@}"
  CONFIG=()
  if test true == $(jj --no-pager --ignore-working-copy log --no-graph \
		       -r "$REV" -T 'self.parents().len() > 1') ; then
    QMSG=$($JJFZF_ABSPATHLIB/draft.sh "$REV" | jjfzf_config_quote)
    CONFIG+=(--config="template-aliases.default_commit_description=$QMSG")
  fi
  export JJFZF_EDITOR="${JJ_EDITOR-}"			# preserve user setting
  export JJ_EDITOR="$JJFZF_ABSPATHLIB/editor.sh"	# wrapper that rejects non-edits
  jjfzf_run +e jj describe --edit "${CONFIG[@]}" "$REV"
)
export -f jjfzf_describe_commit

# Describe with LLM assistance
RUN[synth]="jjfzf_describe_llm {2}"
DOC[synth]='Use `jj describe` to edit a synthetic LLM generated description of the currently selected revision.'
KEY[synth]="Ctrl-S"
jjfzf_describe_llm()
(
  set -Eeuo pipefail
  REV="${1-@}"
  CONFIG=()
  COMMIT=$($JJFZFT 'if(description, "", commit_id)' -r "$REV")
  if test -n "$COMMIT" ; then
    echo '[template-aliases]'			>  $JJFZF_TEMPD/llmdraft.toml
    echo -n "default_commit_description="	>> $JJFZF_TEMPD/llmdraft.toml
    $JJFZF_ABSPATHLIB/gen-message.py --dup-output "$COMMIT" |
      jjfzf_config_quote '' ''			>> $JJFZF_TEMPD/llmdraft.toml # $'\n'
    CONFIG+=( --config-file $JJFZF_TEMPD/llmdraft.toml )
  fi
  export JJFZF_EDITOR="${JJ_EDITOR-}"			# preserve $JJ_EDITOR user settings
  export JJ_EDITOR="$JJFZF_ABSPATHLIB/editor.sh"	# use hash-comparing wrapper
  jjfzf_run +e jj describe --edit "${CONFIG[@]}" "$REV"
)
export -f jjfzf_describe_llm

# Edit
KEY[edit]="Ctrl-E"
RUN[edit]="jjfzf_run jj --no-pager \$($JJFZFT \"if(immutable,'new','edit')\" -r {2}) {2}"
DOC[edit]='Use `jj {edit|new}` to set the currently selected revision (or divergent commit) as the working-copy revision. Will create a new empty commit if the selected revision is immutable.'

